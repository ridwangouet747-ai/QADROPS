# Copiez ce fichier en .env.local. L'application web d'accueil démarre sans ces services.
# Les routes d'authentification et les outils de base de données nécessitent leurs variables.

# Démonstration locale : utiliser `npm run preview` (PGlite isolé en mémoire).
# Cette option ne remplace jamais DATABASE_URL et est refusée hors développement.
QADR_PREVIEW_MODE=false

# PostgreSQL Neon — URL de la base de développement uniquement.
# Application : chaîne « pooled » (hôte avec -pooler).
DATABASE_URL=
# Facultatif, migrations seulement (drizzle-kit, npm run db:migrate) : chaîne directe, sans -pooler.
# Sans elle, les migrations utilisent DATABASE_URL. L'application ne la lit jamais.
# DATABASE_URL_UNPOOLED=

# Better Auth : secret aléatoire d'au moins 32 caractères, généré localement.
# En production, BETTER_AUTH_URL est obligatoire et en HTTPS (adresse publique exacte), sinon l'authentification refuse de démarrer.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Turnstile — fournir les deux clés ensemble. Aucun secret réel dans ce fichier.
# Développement local : clés de test officielles de Cloudflare (toujours valides, refusées en production)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production : clés du widget créé dans le tableau de bord Cloudflare, domaine de BETTER_AUTH_URL autorisé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — e-mails transactionnels (invitations, réinitialisation, vérification), envoyés côté serveur.
# Les deux premières variables vont ensemble ; sans elles, aucun e-mail n'est envoyé et l'interface le dit.
# Les liens des e-mails utilisent BETTER_AUTH_URL. Ne jamais préfixer ces variables par NEXT_PUBLIC_.
# RESEND_FROM_EMAIL : adresse d'un domaine vérifié dans Resend, par exemple « QADR OPS <no-reply@votre-domaine> ».
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Facultatif : adresse de réponse (support).
RESEND_REPLY_TO=

# Connexion sociale (mission 13), côté serveur uniquement. Chaque paire va ensemble ; sans elle, le bouton
# n'est pas affiché. Les comptes ne sont liés automatiquement que si l'adresse est vérifiée des deux côtés.
# Google : identifiants OAuth « Application Web » (Google Cloud Console), URI de redirection autorisée :
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : Services ID (APPLE_CLIENT_ID) et secret client = JWT ES256 signé avec la clé .p8, valable 6 mois au
# plus, produit par `node scripts/apple-client-secret.mjs` (à renouveler avant expiration). Apple exige HTTPS :
# le bouton n'apparaît que si BETTER_AUTH_URL commence par https://. Retour : <BETTER_AUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Facultatif : identifiant d'application iOS native (connexion par jeton d'identité).
APPLE_APP_BUNDLE_IDENTIFIER=

# Sentry : renseigner un DSN de développement local et des valeurs distinctes dans Vercel
# Preview / Production. Le code reste inactif si les DSN sont absents.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TEST_ENABLED=false

# PostHog : désactivé si l'une des deux variables manque.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# (mission 10) Chargé seulement après l'accord de la personne. Clé PUBLIQUE de projet (phc_…), jamais une clé
# personnelle d'API. Hébergement européen : https://eu.i.posthog.com

# Notifications push (Web Push / VAPID, mission 10). Générer avec : node scripts/generate-vapid-keys.mjs
# Sans ces trois variables, les notifications internes fonctionnent et le push est simplement désactivé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Secret (32 caractères au moins) de la tâche planifiée /api/internal/notifications/process appelée en POST par un
# planificateur externe. Vercel Cron (GET) utilise CRON_SECRET ci-dessous, accepté aussi par cette route.
NOTIFICATIONS_CRON_SECRET=

# Stockage privé des fichiers (Cloudflare R2, docs/storage-r2.md). Les quatre premières variables vont ensemble ;
# sans elles, en production, aucun fichier n'est conservé (l'import fonctionne quand même et le dit).
# Le jeton d'API R2 doit être limité à « Object Read & Write » sur ce seul bucket. Bucket jamais public.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Facultatif : juridiction du bucket (eu ou fedramp) s'il a été créé avec une juridiction.
# R2_JURISDICTION=
# Développement uniquement : stockage en mémoire du processus (refusé en production). L'aperçu l'active seul.
# QADR_FILE_STORAGE=memory
# Facultatif : plafonds et durées de conservation (valeurs par défaut entre parenthèses).
# QADR_STORAGE_IMPORT_MAX_BYTES=      (2097152, maximum 20 Mio)
# QADR_STORAGE_IMPORT_RETENTION_DAYS= (90)
# QADR_STORAGE_EXPORT_MAX_BYTES=      (10485760, maximum 50 Mio ; exports pas encore branchés)
# QADR_STORAGE_EXPORT_RETENTION_DAYS= (7)

# Paiement des abonnements Qadr Ops par GeniusPay (mission 12, docs/billing-geniuspay.md). Serveur uniquement,
# jamais NEXT_PUBLIC_. Les trois secrets vont ensemble ; sans eux, le paiement en ligne est annoncé indisponible.
# L'environnement se lit sur le préfixe des clés : pk_sandbox_/sk_sandbox_ (refusées en production, sauf
# VERCEL_ENV=preview) ou pk_live_/sk_live_ (refusées hors production). Secret de webhook au format whsec_.
# Les adresses de retour sont construites sur BETTER_AUTH_URL (HTTPS obligatoire en production).
# GENIUSPAY_API_KEY=
# GENIUSPAY_API_SECRET=
# GENIUSPAY_WEBHOOK_SECRET=
# URL de l'API Merchant ; par défaut https://geniuspay.ci/api/v1/merchant (hôte à faire confirmer par GeniusPay).
# GENIUSPAY_BASE_URL=

# Passage planifié quotidien des abonnements (/api/cron/subscriptions : rapprochement GeniusPay puis expiration). Au moins 32 caractères ;
# sans valeur, la route répond 404. À renseigner uniquement chez l'hébergeur. Vercel l'envoie de lui-même aux
# deux tâches déclarées dans vercel.json (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
