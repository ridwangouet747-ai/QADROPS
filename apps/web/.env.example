# Copiez ce fichier en .env.local. L'application web d'accueil démarre sans ces services.
# Les routes d'authentification et les outils de base de données nécessitent leurs variables.

# Démonstration locale : utiliser `npm run preview` (PGlite isolé en mémoire).
# Cette option ne remplace jamais DATABASE_URL et est refusée hors développement.
QADR_PREVIEW_MODE=false

# PostgreSQL Neon — URL de la base de développement uniquement.
DATABASE_URL=

# Better Auth : secret aléatoire d'au moins 32 caractères, généré localement.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Turnstile — fournir les deux clés ensemble. Aucun secret réel dans ce fichier.
# Développement local : clés de test officielles de Cloudflare (toujours valides, refusées en production)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production : clés du widget créé dans le tableau de bord Cloudflare, domaine de BETTER_AUTH_URL autorisé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — e-mails transactionnels (invitations, réinitialisation, vérification), envoyés côté serveur.
# Les deux premières variables vont ensemble ; sans elles, aucun e-mail n'est envoyé et l'interface le dit.
# Les liens des e-mails utilisent BETTER_AUTH_URL. Ne jamais préfixer ces variables par NEXT_PUBLIC_.
# RESEND_FROM_EMAIL : adresse d'un domaine vérifié dans Resend, par exemple « QADR OPS <no-reply@votre-domaine> ».
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Facultatif : adresse de réponse (support).
RESEND_REPLY_TO=

# Sentry : renseigner un DSN de développement local et des valeurs distinctes dans Vercel
# Preview / Production. Le code reste inactif si les DSN sont absents.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TEST_ENABLED=false

# PostHog : désactivé si l'une des deux variables manque.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare R2 : à définir uniquement lors de la création d'un véritable module d'upload.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Passage planifié d'expiration des abonnements (/api/cron/subscriptions). Au moins 32 caractères ;
# sans valeur, la route répond 404. À renseigner uniquement chez l'hébergeur.
CRON_SECRET=
