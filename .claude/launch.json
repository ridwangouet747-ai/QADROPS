{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qadr-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "preview"],
      "port": 3001
    },
    {
      "name": "qadr-web-preview-slow-network",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "preview"],
      "env": {
        "NODE_OPTIONS": "--network-family-autoselection-attempt-timeout=3000"
      },
      "port": 3001
    },
    {
      "name": "qadr-web-cloudflare",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "exec", "--", "wrangler", "dev", "--config", "apps/web/wrangler.jsonc", "--port", "8787"],
      "env": {
        "NODE_OPTIONS": "--network-family-autoselection-attempt-timeout=3000"
      },
      "port": 8787
    },
    {
      "name": "qadr-web-preview-billing-display",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "preview"],
      "env": {
        "GENIUSPAY_API_KEY": "pk_sandbox_test_harnais",
        "GENIUSPAY_API_SECRET": "sk_sandbox_test_harnais",
        "GENIUSPAY_WEBHOOK_SECRET": "whsec_test_harnais_qadr_ops",
        "GENIUSPAY_BASE_URL": "https://geniuspay.test.invalid/api/v1/merchant"
      },
      "port": 3001
    },
    {
      "name": "qadr-web-preview-geniuspay-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "preview"],
      "env": {
        "BETTER_AUTH_URL": "http://localhost:3001",
        "QADR_PREVIEW_HOSTNAME": "127.0.0.1"
      },
      "port": 3001
    },
    {
      "name": "qadr-web-preview-turnstile-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "preview"],
      "env": {
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      },
      "port": 3001
    }
  ]
}
